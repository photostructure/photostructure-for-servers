# syntax=docker/dockerfile:1

# This image adds patent-encumbered media codecs (FFmpeg, HEIF) to the base
# PhotoStructure image. By building this image, you accept responsibility for
# any applicable patent licensing requirements.
#
# UPDATE 2024-04-15: Visit /welcome/tools inside the running app instead — it
# handles consent, logging, and auto-restore on container rebuild. This
# Dockerfile is for CI/CD, air-gapped, or no-runtime-sudo environments.
#
# Build:   docker build -f server/Dockerfile.nonfree -t photostructure-nonfree .
# Run:     docker run ... photostructure-nonfree

FROM photostructure/server:beta

# Trixie ships libheif 1.19.x which handles modern HEIF features (iPhone 16 Pro
# etc.) without backports, and ffmpeg 7.1.x which is plenty modern for
# PhotoStructure's use.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
  ffmpeg heif-thumbnailer libheif-examples \
  && rm -rf /var/lib/apt/lists/*
